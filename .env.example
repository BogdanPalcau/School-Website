# Optional: ZeroGPT API key for external AI detection (can also be set in Admin → External AI detection)
ZEROGPT_API_KEY=

# Optional: Google Safe Browsing API key for checking external course links before opening
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: path to LibreOffice soffice for better PDF/DOC text extraction
# PORTAL_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# Public base URL of the portal (no trailing slash). Required for password-reset
# and invite emails — those links are never built from the HTTP Host header.
# Example: http://localhost/School-Website-main/public
# Invite links can still be copied from Admin without this; email delivery needs it.
PORTAL_BASE_URL=

# Secret used to HMAC password-reset and invite tokens. Generate a long random string for production.
PORTAL_APP_SECRET=

# Outbound email (PHPMailer / SMTP). Required for self-service password reset,
# grade return emails, deadline reminders, and student invite emails.
# After setting these, run: composer install
# Schedule deadline reminders (hourly or daily), e.g.:
#   php scripts/send_notification_emails.php --hours=24
# Student invites: Admin → Student Invites (copyable link always; email when SMTP is ready).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
